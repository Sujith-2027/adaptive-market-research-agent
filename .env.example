# Required (free, email signup): https://console.groq.com
GROQ_API_KEY=your_groq_key

# Optional model overrides (copy IDs from the Groq models page if these change)
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_SMART_MODEL=openai/gpt-oss-120b
# GROQ_SMART2_MODEL=

# Optional: only add if signup stays free and card-free
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Optional: better search. Without it the app uses keyless DuckDuckGo search.
# TAVILY_API_KEY=
